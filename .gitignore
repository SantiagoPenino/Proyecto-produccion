# ======================================================================
# Se ignora por RUTA. No volver a poner *.md / *.json / *.bat / docs
# globales: escondían archivos que el código necesita (public/manifest.json,
# texturas.json, reglas_user.json) y la documentación (CHANGELOG, specs, docs).
# Auditoría de limpieza 09/10/2026: docs/auditoria-limpieza-2026-10-09.md §14.
# *.sql SÍ va global desde el 16/10/2026 (pedido de Santiago), con excepción
# explícita para cada .sql que el código lee (ver la sección SQL).
# ======================================================================

# --- Dependencias y builds ---
node_modules/
dist/
dist-ssr/
*.local
# Salida de `vite build` (outDir en vite.config.js): se regenera en cada deploy
backend/public/
.tmp/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Secretos: nunca entran (un .env.example sí se puede subir) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/oauth-credentials.json
backend/token.json

# --- Carpetas que el backend crea en runtime. En producción las apuntan las *_PATH
#     del .env. Con el nombre exacto del código: en Linux importan las mayúsculas ---
backend/uploads/
backend/thumbnails/
backend/ordenes/
backend/scratch/
backend/tickets/
backend/consultas/
backend/servicio-tecnico/
backend/desarrollos-adjuntos/
backend/fallas/
backend/ComprobantesPagos/
backend/comprobantesPagos/
backend/comprobantesEncomiendas/
backend/Comprobantes/
backend/stock/compras/
# Salidas de scripts: reimprimir_etiqueta.js escribe al lado; wmsBajarSnapshot.js baja a wms-snap/
backend/scripts/etiqueta_*.html
wms-snap/
# exportar_productos_publicados.js: el .sql + fotos para pasar productos a otra base
scripts/pasar_publicados/
scripts/pasar_publicados.zip

# --- Generados, bytecode y backups (esto sí por extensión: nunca son fuente) ---
nul
__pycache__/
*.pyc
*.bak
*.bak.*
*.backup.*
*.orig
*.tmp

# --- SQL: fuera del repo (16/10/2026). Scripts y migraciones viven en cada máquina ---
*.sql
# poslinkService.asegurarEsquema lo lee al arrancar para crear sus tablas: sin él, POSLink falla
!backend/scripts/sql/poslink_2026-10-12.sql

# --- Respaldos, backups y comprimidos (16/10/2026) ---
backend/respaldos/
backend/backup_*.json
*.rar
*.zip
# Rutas de un scratchpad pegadas como nombre de archivo (git add de un temporal)
*scratchpad*

